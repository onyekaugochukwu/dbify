{
  "name": "dbify",
  "version": "1.0.0",
  "description": "SQL in your browser for learning and teaching: SQLite, DuckDB and PostgreSQL, zero install, works offline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode single && node scripts/copy-single.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "test": "node scripts/make-fixtures.js && node scripts/test.js",
    "make-sample": "node scripts/make-sample.js",
    "icons": "node scripts/make-icons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyekaugochukwu/dbify.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onyekaugochukwu/dbify/issues"
  },
  "homepage": "https://github.com/onyekaugochukwu/dbify#readme",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/papaparse": "^5.5.2",
    "hyparquet-writer": "^0.18.0",
    "puppeteer-core": "^25.18.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
